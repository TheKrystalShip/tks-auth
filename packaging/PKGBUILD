# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# Compiles nothing. CI publishes the Native-AOT binary and builds the pages into ui/ beside it first,
# and this places the result, so the packaged bytes are the tested bytes. Point TKS_AUTH_STAGE at that
# publish output, or leave it unset to use ../artifacts/publish, which is where deploy.sh leaves one.
#

pkgname=tks-auth
pkgver=1.4.0
pkgrel=1
pkgdesc="tks-auth — an OpenID Connect provider: accounts, applications and their roles"
arch=('x86_64')
url="https://github.com/TheKrystalShip/tks-auth"
license=('GPL-3.0-or-later')
# The daemon runs as its own system user, created from the sysusers fragment this ships. It is installed
# and left off; enable it once its issuer is set.
depends=('systemd')
# The package the pages of an earlier layout came in, which these pages replace.
replaces=('kgsm-web-auth')
conflicts=('kgsm-web-auth')
backup=('etc/tks-auth/tks-auth.env'
        'etc/tks-auth/providers.env')
install="tks-auth.install"
optdepends=(
    'nginx: serves the provider at its issuer address (tks-auth-serve.service)'
    'certbot: issues the certificate of an https issuer'
)
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')

_stage() { printf '%s' "${TKS_AUTH_STAGE:-${startdir}/../artifacts/publish}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -f "${stage}/tks-auth" ]] || {
        printf '\n  no publish output at %s\n' "$stage" >&2
        printf '  build it first:  dotnet publish src/Auth.Server/Server.csproj -c Release -r linux-x64 -o artifacts/publish\n' >&2
        printf '  or point TKS_AUTH_STAGE at an existing one.\n\n' >&2
        return 1
    }
    # The pages are part of what this ships: without them the daemon serves a plain sign-in form and no
    # account or admin pages, which is a package that installs and is not tks-auth.
    [[ -f "${stage}/ui/auth-sign-in.html" && -f "${stage}/ui/admin.html" ]] || {
        printf '\n  no pages at %s/ui\n' "$stage" >&2
        printf '  build them first:  (cd web && npm ci && npm run build && npm run check) && cp -a web/dist artifacts/publish/ui\n\n' >&2
        return 1
    }
}

package() {
    local repo="${startdir}/.." stage; stage="$(_stage)"
    local prefix="${pkgdir}/opt/${pkgname}"

    # The AOT binary, the SQLite native lib it dlopens and the settings file, exactly as published, and
    # the pages in ui/ beside them, where the settings file's UiPath points.
    install -dm755 "$prefix"
    cp -a "${stage}/." "${prefix}/"
    # A published tree carries build leftovers a package should not.
    rm -f "${prefix}"/*.pdb "${prefix}"/*.dbg "${prefix}"/*.xml

    install -Dm644 "${repo}/deploy/tks-auth.service" \
        "${pkgdir}/usr/lib/systemd/system/tks-auth.service"

    # Operator overrides. Seeded from the committed example — every knob commented — and listed in
    # backup=(), so an upgrade writes .pacnew beside an edited file rather than over it. Root-owned
    # 0640 is correct rather than strict: systemd reads EnvironmentFile= as root before dropping to
    # User=, so nothing reads this as the service account.
    install -Dm640 "${repo}/deploy/tks-auth.env.example" \
        "${pkgdir}/etc/${pkgname}/${pkgname}.env"

    # The sign-in providers' applications, on the same terms: a real file with blank keys, since no
    # package may carry a credential, kept across upgrades by backup=().
    install -Dm640 "${repo}/deploy/providers.env.example" \
        "${pkgdir}/etc/${pkgname}/providers.env"

    # The system user the unit runs as.
    install -Dm644 "${repo}/packaging/tks-auth.sysusers" "${pkgdir}/usr/lib/sysusers.d/tks-auth.conf"

    # Serving the provider at its one address, the host of the issuer in /etc/tks-auth/tks-auth.env: the
    # oneshot that issues the name's certificate and renders its vhost, and the templates it reads.
    install -Dm755 "${repo}/deploy/serving/tks-auth-serve" "${pkgdir}/usr/lib/tks-auth/serving/tks-auth-serve"
    install -Dm644 "${repo}/deploy/serving/tks-auth.conf.in" "${pkgdir}/usr/lib/tks-auth/serving/tks-auth.conf.in"
    install -Dm644 "${repo}/deploy/serving/acme.conf" "${pkgdir}/usr/lib/tks-auth/serving/acme.conf"
    install -Dm755 "${repo}/deploy/serving/reload-nginx.hook" "${pkgdir}/usr/lib/tks-auth/serving/reload-nginx.hook"
    install -Dm644 "${repo}/deploy/serving/tks-auth-serve.service" \
        "${pkgdir}/usr/lib/systemd/system/tks-auth-serve.service"

    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
