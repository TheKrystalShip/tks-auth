# tks-auth — the networks that may reach the admin pages and the application and authority-check
# routes. Read by the geo block in /etc/nginx/conf.d/00-tks-auth-sites.conf as `<cidr> 1;` lines;
# every other address gets the daemon's unknown-path 404 for those routes. An operator edits this
# file, and `nginx -s reload` applies it. Install and upgrade leave an edited copy in place.
127.0.0.0/8 1;
::1/128 1;
10.0.0.0/8 1;
172.16.0.0/12 1;
192.168.0.0/16 1;
fc00::/7 1;
