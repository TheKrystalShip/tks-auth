# ── tks-auth — host overrides ─────────────────────────────────────────
# Seeded once by deploy/setup.sh and never written again, so anything set here survives every
# redeploy. The keys the daemon reads are declared in tks-auth.settings.json beside the binary; the
# issuer below is this file's alone.
#
# The unit's own Environment= lines carry working defaults for everything else; without an issuer
# the provider signs nobody in.

# This provider's one address: the URL browsers sign in at, stamped as the issuer on every token and
# the origin every provider callback is built on. Set here and nowhere else. An https URL is served by
# tks-auth-serve, which issues the name's certificate and renders its vhost; an http URL is this
# provider reached directly on its port. Until it is a URL the OpenID Connect doors sign nobody in.
# Changing it signs everybody out and moves every provider callback, so a sign-in provider's
# application has to register the new ones.
#Auth__Issuer=https://auth.example.com

# Where Let's Encrypt writes about the certificate for the issuer's name. Blank registers no address.
#TKS_AUTH_ACME_EMAIL=admin@example.com

# Where this provider listens. Loopback by default, because the vhost publishes it and holds the
# certificate. Change the port here rather than in the unit.
#Auth__ListenAddress=http://127.0.0.1:8098

# How long a bearer lasts, and how long somebody stays signed in.
#Auth__AccessLifetimeMinutes=15
#Auth__RefreshLifetimeDays=30

# Whether a person with no account may create one from the sign-in page.
#Auth__AllowSelfRegistration=false

# Minimum severity logged.
#Logging__LogLevel__Default=Information
