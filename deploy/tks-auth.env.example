# ── tks-auth — host overrides ─────────────────────────────────────────
# Seeded once by deploy/setup.sh and never written again, so anything set here survives every
# redeploy. The keys the Control Panel can also set are declared in tks-auth.settings.json beside
# the binary; the issuer below is this file's alone.
#
# The unit's own Environment= lines carry working defaults for everything else; without an issuer
# the provider signs nobody in.
#
# The cluster secret is NOT here. It is host-level, in /etc/kgsm/kgsm-cluster.env, because a
# machine can run more than one member and they all carry the same one.

# This provider's one address: the URL browsers sign in at, stamped as the issuer on every session,
# the origin every provider callback is built on, and where other members reach it. Set here and
# nowhere else. An https URL is served by tks-auth-serve, which issues the name's certificate and renders
# its vhost; an http URL is this provider reached directly on its port. Until it is a URL the OpenID
# Connect doors sign nobody in. Changing it signs everybody out and moves every provider callback, so a
# sign-in provider's application has to register the new ones.
#Anchor__Issuer=https://auth.example.com

# Where Let's Encrypt writes about the certificate for the issuer's name. Blank registers no address.
#TKS_AUTH_ACME_EMAIL=admin@example.com

# Where this provider listens. Loopback by default, because the vhost publishes it and holds the
# certificate. Change the port here rather than in the unit.
#Anchor__ListenAddress=http://127.0.0.1:8098

# The cluster this anchor holds the accounts for. It is the audience of every session it mints, so
# changing it on a running cluster signs everybody out.
#Anchor__ClusterId=kgsm-cluster

# How long a bearer lasts, and how long somebody stays signed in.
#Anchor__AccessLifetimeMinutes=15
#Anchor__RefreshLifetimeDays=30

# Minimum severity this anchor logs.
#Logging__LogLevel__Default=Information
