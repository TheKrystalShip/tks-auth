<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Auth</RootNamespace>
    <AssemblyName>TheKrystalShip.Auth</AssemblyName>

    <!--
      Zero package dependencies, by design: a pure library with no HTTP, no configuration binder and no
      ORM. The projects that need those sit beside it.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <IsPackable>false</IsPackable>
    <Description>
      Provider-agnostic identity: AccountIdentity, the failure a provider or the account store reports
      when it cannot answer, the session claim names and the provider:name actor convention. A session
      proves who somebody is and nothing more; what they may do is Auth.Access's. Dependency-free and
      AOT-safe.
    </Description>
  </PropertyGroup>

</Project>
