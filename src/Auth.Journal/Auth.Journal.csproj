<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <RootNamespace>TheKrystalShip.Auth.Journal</RootNamespace>
    <AssemblyName>TheKrystalShip.Auth.Journal</AssemblyName>

    <Description>
      The names and payload writers of the provider's audit events: signing in, signing out, revocation,
      account lifecycle, identity links, lockouts, role and assignment changes and application changes.
    </Description>
  </PropertyGroup>

  <!-- No package references: the names and the bytes written for each are the whole of it. -->

</Project>
