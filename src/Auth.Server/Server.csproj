<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT. Nothing this daemon uses blocks it: the host is the slim builder with minimal APIs
         rather than MVC, storage is raw ADO SQLite rather than an ORM, and every wire shape is
         serialized through a source-generated context. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <RootNamespace>TheKrystalShip.Auth.Server</RootNamespace>
    <AssemblyName>tks-auth</AssemblyName>
    <Version>7.0.3</Version>
    <Description>
      tks-auth: an OpenID Connect provider holding accounts, registered applications and each
      application's roles, and signing people in to them.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The settings file, named for this daemon rather than appsettings.json so it cannot collide with
         a sibling's config if they ever share a directory. The Web SDK only auto-copies the literal
         "appsettings.json", so the renamed file needs an explicit item to reach bin/ and publish/.
         Program.cs loads it from AppContext.BaseDirectory, where deploy installs it. -->
    <Content Update="tks-auth.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Auth.Users/Auth.Users.csproj" />
    <ProjectReference Include="../Auth.Journal/Auth.Journal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scoped, same advisory and same reasoning as Auth.Users' own: a native SQLite lib pulled in
         transitively, where the flagged version is the latest published build and there is nothing to
         move to. A suppression does not travel with a reference, so the consuming project declares its
         own. Delete it the moment a patched SQLitePCLRaw bundle ships. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.Auth.Server.Tests" />
  </ItemGroup>

</Project>
