<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Auth.Sessions.Testing</RootNamespace>
    <AssemblyName>TheKrystalShip.Auth.Sessions.Testing</AssemblyName>

    <PackageId>TheKrystalShip.Auth.Sessions.Testing</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.0.0-dev.1</Version>
    <Description>
      A provider for a service's tests: discovery, a key set holding an ES256 key and an RSA one, a token
      endpoint whose exchanges a test answers, and access tokens minted the way tks-auth mints them, for a host
      that admits people through TheKrystalShip.Auth.Sessions.
    </Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sessions/Sessions.csproj" />
  </ItemGroup>

</Project>
