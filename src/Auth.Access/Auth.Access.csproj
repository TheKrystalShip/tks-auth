<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Auth.Access</RootNamespace>
    <AssemblyName>TheKrystalShip.Auth.Access</AssemblyName>
    <IsPackable>false</IsPackable>

    <!--
      Zero package dependencies and AOT-safe: the rules over what the account store read. Reading the
      store is Auth.Users' job.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <Description>
      The provider's access model and its evaluator: actions declared by applications, permissions
      bundling them, ranked roles and the assignments that give a person a role. Allows(account, action)
      answers every access question, and the administration rules decide which changes to it a caller
      may make. Dependency-free and AOT-safe.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.Auth.Access.Tests" />
  </ItemGroup>

</Project>
